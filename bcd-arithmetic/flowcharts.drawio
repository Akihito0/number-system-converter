<mxfile host="Electron" modified="2026-10-03T14:00:00.000Z" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/24.0.0 Chrome/120.0.6099.109 Electron/28.1.0 Safari/537.36" version="24.0.0" type="device">

  <!-- ============================================================== -->
  <!-- DIAGRAM 1: BCD Arithmetic App Lifecycle & Expression Flow      -->
  <!-- ============================================================== -->
  <diagram id="diagram-bcd-lifecycle" name="1. BCD App Lifecycle &amp; Expression Flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="bcd-title" value="BCD Addition &amp;amp; Subtraction — Application Lifecycle &amp;amp; Event-Driven Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1a237e;" vertex="1" parent="1">
          <mxGeometry x="150" y="15" width="850" height="30" as="geometry" />
        </mxCell>

        <!-- Initial Load -->
        <mxCell id="b101" value="User Opens BCD Arithmetic Page&lt;br&gt;(bcd-arithmetic/index.html)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#e8eaf6;strokeColor=#3f51b5;fontStyle=1;fontSize=12;fontColor=#1a237e;" vertex="1" parent="1">
          <mxGeometry x="450" y="65" width="260" height="50" as="geometry" />
        </mxCell>

        <!-- Script Initializer -->
        <mxCell id="b102" value="Script Initialization (bcd-ui.js)&lt;br&gt;• Cache DOM references&lt;br&gt;• Attach event listeners&lt;br&gt;• Call createOperandCards(4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#757575;fontSize=11;fontColor=#212121;" vertex="1" parent="1">
          <mxGeometry x="470" y="145" width="220" height="65" as="geometry" />
        </mxCell>

        <!-- Initial Grid & Toolbar -->
        <mxCell id="b103" value="Render Initial State&lt;br&gt;• 4 Operands Grid (A, B, C, D) 4 per row&lt;br&gt;• Variables Toolbar [A: —] [B: —] [C: —] [D: —]&lt;br&gt;• Restricted Operators [ + ] [ − ] [ ( ] [ ) ] [ Clear ]&lt;br&gt;• Default Expression: A + B − C + D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11;fontColor=#01579b;" vertex="1" parent="1">
          <mxGeometry x="440" y="240" width="280" height="75" as="geometry" />
        </mxCell>

        <!-- Event Router Diamond -->
        <mxCell id="b104" value="User Action / Event Loop" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontStyle=1;fontSize=13;fontColor=#f57f17;" vertex="1" parent="1">
          <mxGeometry x="475" y="345" width="210" height="80" as="geometry" />
        </mxCell>

        <!-- Branch 1: Set Number of Operands -->
        <mxCell id="b105" value="Change Input Count (2–10)&lt;br&gt;&amp;amp; Click 'Set Inputs'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#673ab7;fontSize=11;fontColor=#311b92;" vertex="1" parent="1">
          <mxGeometry x="50" y="455" width="210" height="55" as="geometry" />
        </mxCell>

        <mxCell id="b106" value="createOperandCards(N)&lt;br&gt;• Rebuild alphabetical cards (A, B, C...)&lt;br&gt;• Refresh variable badges in toolbar&lt;br&gt;• Set default expression (A + B − C...)&lt;br&gt;• Clear previous result container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#673ab7;fontSize=11;fontColor=#311b92;" vertex="1" parent="1">
          <mxGeometry x="50" y="540" width="210" height="75" as="geometry" />
        </mxCell>

        <!-- Branch 2: Input Number / Toggle Base -->
        <mxCell id="b107" value="Type Operand String&lt;br&gt;OR Toggle Radix (10 Dec / 2 Bin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#4caf50;fontSize=11;fontColor=#1b5e20;" vertex="1" parent="1">
          <mxGeometry x="290" y="455" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="b108" value="updateCardPreview() &amp;amp; validate&lt;br&gt;• Base 10: check decimal digits (0–9)&lt;br&gt;• Base 2: check BCD nibbles / bits (0–1)&lt;br&gt;• Update in-card live BCD preview&lt;br&gt;• Sync toolbar live preview badge [A: Val]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#4caf50;fontSize=11;fontColor=#1b5e20;" vertex="1" parent="1">
          <mxGeometry x="290" y="540" width="220" height="75" as="geometry" />
        </mxCell>

        <!-- Branch 3: Expression Toolbar Interaction -->
        <mxCell id="b109" value="Click Toolbar Button&lt;br&gt;(Variable A-J or Operator + / − / ( / ))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#e91e63;fontSize=11;fontColor=#880e4f;" vertex="1" parent="1">
          <mxGeometry x="540" y="455" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="b110" value="insertAtCursor(input, token)&lt;br&gt;• Insert symbol at caret position&lt;br&gt;• Add spaces around + and − operators&lt;br&gt;• Maintain focus in expression input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#e91e63;fontSize=11;fontColor=#880e4f;" vertex="1" parent="1">
          <mxGeometry x="540" y="540" width="220" height="65" as="geometry" />
        </mxCell>

        <!-- Branch 4: Perform BCD Operation -->
        <mxCell id="b111" value="Click 'Perform BCD Operation'&lt;br&gt;OR Press 'Enter' Key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;fontSize=11;fontColor=#e65100;" vertex="1" parent="1">
          <mxGeometry x="790" y="455" width="230" height="55" as="geometry" />
        </mxCell>

        <mxCell id="b112" value="evaluateBCDExpression()&lt;br&gt;• Gather &amp;amp; validate operand values&lt;br&gt;• Recursive descent parser (+, −, ( ))&lt;br&gt;• Evaluate + via BCD (+6 correction)&lt;br&gt;• Evaluate − via 9's &amp;amp; 10's complements&lt;br&gt;• Generate Step-by-Step Proof&lt;br&gt;• Smooth scroll to results container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;fontSize=11;fontColor=#e65100;" vertex="1" parent="1">
          <mxGeometry x="790" y="540" width="230" height="95" as="geometry" />
        </mxCell>

        <!-- Idle Node -->
        <mxCell id="b113" value="Render Results / Wait for Next Event" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#9e9e9e;fontStyle=1;fontSize=12;fontColor=#424242;" vertex="1" parent="1">
          <mxGeometry x="450" y="700" width="260" height="40" as="geometry" />
        </mxCell>

        <!-- Connecting Edges -->
        <mxCell id="be1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3f51b5;strokeWidth=2;" edge="1" parent="1" source="b101" target="b102"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#757575;strokeWidth=2;" edge="1" parent="1" source="b102" target="b103"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0288d1;strokeWidth=2;" edge="1" parent="1" source="b103" target="b104"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="be4" value="Count Changed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#673ab7;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="b104" target="b105"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="440" /><mxPoint x="155" y="440" /></Array></mxGeometry></mxCell>
        <mxCell id="be5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#673ab7;strokeWidth=2;" edge="1" parent="1" source="b105" target="b106"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="be6" value="Type / Base Toggle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4caf50;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="b104" target="b107"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="440" /><mxPoint x="400" y="440" /></Array></mxGeometry></mxCell>
        <mxCell id="be7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4caf50;strokeWidth=2;" edge="1" parent="1" source="b107" target="b108"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="be8" value="Insert Variable/Op" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e91e63;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="b104" target="b109"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="440" /><mxPoint x="650" y="440" /></Array></mxGeometry></mxCell>
        <mxCell id="be9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e91e63;strokeWidth=2;" edge="1" parent="1" source="b109" target="b110"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="be10" value="Calculate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ff9800;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="b104" target="b111"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="440" /><mxPoint x="905" y="440" /></Array></mxGeometry></mxCell>
        <mxCell id="be11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ff9800;strokeWidth=2;" edge="1" parent="1" source="b111" target="b112"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Return Edges to Idle Node -->
        <mxCell id="be12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#673ab7;strokeWidth=1.5;" edge="1" parent="1" source="b106" target="b113"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="155" y="670" /><mxPoint x="580" y="670" /></Array></mxGeometry></mxCell>
        <mxCell id="be13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4caf50;strokeWidth=1.5;" edge="1" parent="1" source="b108" target="b113"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="670" /><mxPoint x="580" y="670" /></Array></mxGeometry></mxCell>
        <mxCell id="be14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e91e63;strokeWidth=1.5;" edge="1" parent="1" source="b110" target="b113"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="670" /><mxPoint x="580" y="670" /></Array></mxGeometry></mxCell>
        <mxCell id="be15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ff9800;strokeWidth=1.5;" edge="1" parent="1" source="b112" target="b113"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="905" y="670" /><mxPoint x="580" y="670" /></Array></mxGeometry></mxCell>

        <!-- Idle loop back to Router -->
        <mxCell id="be16" value="Next Interaction" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9e9e9e;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="b113" target="b104">
          <mxGeometry relative="1" as="geometry">

        <mxCell id="e503" value="10's Complement" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#673ab7;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="502" target="508"><mxGeometry relative="1" as="geometry" /></mxCell>

  </diagram>

  <!-- ============================================================== -->
  <!-- DIAGRAM 2: BCD Addition Pipeline with +6 (0110) Correction      -->
  <!-- ============================================================== -->
  <diagram id="diagram-bcd-addition" name="2. BCD Addition (+6 Correction)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="bcd-t1" value="BCD Addition Algorithm — Column-by-Column +6 Correction Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1a237e;" vertex="1" parent="1">
          <mxGeometry x="250" y="10" width="650" height="30" as="geometry" />
        </mxCell>

        <mxCell id="401" value="Start: Input Addends A &amp;amp; B&lt;br&gt;(Decimal or Binary/BCD)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#e8eaf6;strokeColor=#3f51b5;fontStyle=1;fontSize=12;fontColor=#1a237e;" vertex="1" parent="1">
          <mxGeometry x="460" y="60" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="402" value="Validate &amp;amp; Normalize Operands&lt;br&gt;• Decimal: check digits 0–9&lt;br&gt;• Binary: decode 4-bit BCD nibbles / base 2&lt;br&gt;• Left-pad A &amp;amp; B with '0' to equal length" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#757575;fontSize=11;fontColor=#212121;" vertex="1" parent="1">
          <mxGeometry x="440" y="140" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="403" value="Initialize Addition State&lt;br&gt;• carry = 0&lt;br&gt;• resultDigits = [ ]&lt;br&gt;• i = rightmost digit index (maxLen − 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11;fontColor=#01579b;" vertex="1" parent="1">
          <mxGeometry x="450" y="240" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="404" value="More columns&lt;br&gt;to process? (i &amp;ge; 0)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontStyle=1;fontSize=12;fontColor=#f57f17;" vertex="1" parent="1">
          <mxGeometry x="470" y="330" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="405" value="Compute Raw Column Sum&lt;br&gt;rawSum = digitA[i] + digitB[i] + carry&lt;br&gt;(Binary: 4-bit addition + carry bit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#673ab7;fontSize=11;fontColor=#311b92;" vertex="1" parent="1">
          <mxGeometry x="450" y="440" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="406" value="rawSum &amp;gt; 9&lt;br&gt;OR carryOut = 1?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#fb8c00;fontStyle=1;fontSize=12;fontColor=#e65100;" vertex="1" parent="1">
          <mxGeometry x="470" y="530" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="407" value="BCD Correction Needed (+0110)&lt;br&gt;• corrected = rawSum + 6 (or rawSum − 10)&lt;br&gt;• carry = 1 (propagate to next column)&lt;br&gt;• Prepend corrected digit to result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#e53935;fontSize=11;fontColor=#b71c1c;" vertex="1" parent="1">
          <mxGeometry x="250" y="640" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="408" value="No Correction (Valid BCD)&lt;br&gt;• corrected = rawSum&lt;br&gt;• carry = 0&lt;br&gt;• Prepend rawSum digit to result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#43a047;fontSize=11;fontColor=#1b5e20;" vertex="1" parent="1">
          <mxGeometry x="630" y="640" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="409" value="Decrement Column Index&lt;br&gt;i = i − 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#00acc1;fontSize=11;fontColor=#006064;" vertex="1" parent="1">
          <mxGeometry x="480" y="745" width="180" height="45" as="geometry" />
        </mxCell>

        <mxCell id="410" value="Final carry &amp;gt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontStyle=1;fontSize=12;fontColor=#f57f17;" vertex="1" parent="1">
          <mxGeometry x="780" y="330" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="411" value="Prepend carry '1' to resultDigits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;fontSize=11;fontColor=#e65100;" vertex="1" parent="1">
          <mxGeometry x="770" y="445" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="412" value="Convert Decimal Result to BCD&lt;br&gt;• Each digit &amp;rarr; 4-bit 8421 nibble&lt;br&gt;• Format: space-separated nibbles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11;fontColor=#01579b;" vertex="1" parent="1">
          <mxGeometry x="760" y="535" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="413" value="Output: Decimal &amp;amp; BCD Result&lt;br&gt;Display Step-by-Step Table" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ede7f6;strokeColor=#673ab7;fontSize=11;fontColor=#311b92;" vertex="1" parent="1">
          <mxGeometry x="745" y="635" width="230" height="60" as="geometry" />
        </mxCell>

        <mxCell id="414" value="End" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#e8eaf6;strokeColor=#3f51b5;fontStyle=1;fontSize=12;fontColor=#1a237e;" vertex="1" parent="1">
          <mxGeometry x="795" y="730" width="130" height="40" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e401" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3f51b5;strokeWidth=2;" edge="1" parent="1" source="401" target="402"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e402" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#757575;strokeWidth=2;" edge="1" parent="1" source="402" target="403"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e403" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0288d1;strokeWidth=2;" edge="1" parent="1" source="403" target="404"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e404" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4caf50;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="404" target="405"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e405" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#673ab7;strokeWidth=2;" edge="1" parent="1" source="405" target="406"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e406" value="Yes (&amp;gt; 9)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e53935;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="406" target="407"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e407" value="No (&amp;le; 9)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#43a047;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="406" target="408"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e408" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e53935;strokeWidth=2;" edge="1" parent="1" source="407" target="409"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e409" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#43a047;strokeWidth=2;" edge="1" parent="1" source="408" target="409"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e410" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00acc1;strokeWidth=2;" edge="1" parent="1" source="409" target="404">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="180" y="768" />
              <mxPoint x="180" y="370" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e411" value="No (All columns done)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f57f17;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="404" target="410"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e412" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e65100;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="410" target="411"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e413" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#43a047;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="410" target="412">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="990" y="370" /><mxPoint x="990" y="565" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e414" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e65100;strokeWidth=2;" edge="1" parent="1" source="411" target="412"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e415" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0288d1;strokeWidth=2;" edge="1" parent="1" source="412" target="413"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e416" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#673ab7;strokeWidth=2;" edge="1" parent="1" source="413" target="414"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ============================================================== -->
  <!-- DIAGRAM 3: BCD Subtraction via 9's and 10's Complements        -->
  <!-- ============================================================== -->
  <diagram id="diagram-bcd-subtraction" name="3. BCD Subtraction (Complements)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="bcd-sub-t1" value="BCD Subtraction Algorithm via 9's and 10's Complements" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1a237e;" vertex="1" parent="1">
          <mxGeometry x="250" y="10" width="650" height="30" as="geometry" />
        </mxCell>

        <mxCell id="501" value="Start: Minuend A, Subtrahend B&lt;br&gt;(Equal length N digits)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#e8eaf6;strokeColor=#3f51b5;fontStyle=1;fontSize=12;fontColor=#1a237e;" vertex="1" parent="1">
          <mxGeometry x="460" y="60" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="502" value="Select Method Branch" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontStyle=1;fontSize=12;fontColor=#f57f17;" vertex="1" parent="1">
          <mxGeometry x="480" y="140" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- Method 1: 9's Complement -->
        <mxCell id="503" value="Method 1: 9's Complement&lt;br&gt;For each digit: compB[i] = 9 − B[i]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#673ab7;fontSize=11;fontColor=#311b92;" vertex="1" parent="1">
          <mxGeometry x="150" y="250" width="250" height="55" as="geometry" />
        </mxCell>

        <mxCell id="504" value="BCD Addition: Sum = A + compB&lt;br&gt;(using column-by-column +6 correction)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11;fontColor=#01579b;" vertex="1" parent="1">
          <mxGeometry x="145" y="340" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="505" value="Carry generated&lt;br&gt;(End-around carry)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#fb8c00;fontStyle=1;fontSize=12;fontColor=#e65100;" vertex="1" parent="1">
          <mxGeometry x="180" y="430" width="190" height="80" as="geometry" />
        </mxCell>

        <mxCell id="506" value="Carry = 1 &amp;rarr; POSITIVE (+)&lt;br&gt;Add 1 to Sum:&lt;br&gt;Final = Sum + 1 (BCD Add)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#43a047;fontSize=11;fontColor=#1b5e20;" vertex="1" parent="1">
          <mxGeometry x="60" y="550" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="507" value="No Carry &amp;rarr; NEGATIVE (−)&lt;br&gt;Take 9's Complement of Sum:&lt;br&gt;Final = −(9's comp of Sum)&lt;br&gt;(If magnitude 0 &amp;rarr; result 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#e53935;fontSize=11;fontColor=#b71c1c;" vertex="1" parent="1">
          <mxGeometry x="280" y="550" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Method 2: 10's Complement -->
        <mxCell id="508" value="Method 2: 10's Complement&lt;br&gt;comp10 = 9's complement of B + 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#673ab7;fontSize=11;fontColor=#311b92;" vertex="1" parent="1">
          <mxGeometry x="720" y="250" width="250" height="55" as="geometry" />
        </mxCell>

        <mxCell id="509" value="BCD Addition: Sum = A + comp10&lt;br&gt;(using column-by-column +6 correction)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11;fontColor=#01579b;" vertex="1" parent="1">
          <mxGeometry x="715" y="340" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="510" value="Carry generated&lt;br&gt;(Discard carry)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#fb8c00;fontStyle=1;fontSize=12;fontColor=#e65100;" vertex="1" parent="1">
          <mxGeometry x="750" y="430" width="190" height="80" as="geometry" />
        </mxCell>

        <mxCell id="511" value="Carry = 1 &amp;rarr; POSITIVE (+)&lt;br&gt;DISCARD the carry:&lt;br&gt;Final = Sum (without carry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#43a047;fontSize=11;fontColor=#1b5e20;" vertex="1" parent="1">
          <mxGeometry x="630" y="550" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="512" value="No Carry &amp;rarr; NEGATIVE (−)&lt;br&gt;Take 10's Complement of Sum:&lt;br&gt;Final = −(10's comp of Sum)&lt;br&gt;(If magnitude 0 &amp;rarr; result 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#e53935;fontSize=11;fontColor=#b71c1c;" vertex="1" parent="1">
          <mxGeometry x="850" y="550" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Join & Output -->
        <mxCell id="513" value="Format Output Result&lt;br&gt;• Decimal Answer: &amp;plusmn;Magnitude&lt;br&gt;• BCD Answer: 4-bit nibbles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#00acc1;fontSize=11;fontColor=#006064;" vertex="1" parent="1">
          <mxGeometry x="465" y="660" width="210" height="55" as="geometry" />
        </mxCell>

        <mxCell id="514" value="End" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#e8eaf6;strokeColor=#3f51b5;fontStyle=1;fontSize=12;fontColor=#1a237e;" vertex="1" parent="1">
          <mxGeometry x="505" y="745" width="130" height="40" as="geometry" />
        </mxCell>


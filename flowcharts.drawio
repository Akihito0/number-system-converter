  <!-- ========================================================== -->
  <!-- DIAGRAM 3: PEMDAS Recursive Descent Parser Flow            -->
  <!-- ========================================================== -->
  <diagram id="diagram-parser" name="3. PEMDAS Parser &amp; Evaluator">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="t3" value="Arithmetic Expression Engine: Lexer &amp;amp; Recursive Descent PEMDAS Evaluator" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#e65100;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- Start Node -->
        <mxCell id="301" value="Expression String &amp;amp; Variables Map&lt;br&gt;(e.g., &quot;(A + B) * C ^ 2&quot;, { A: 10n, B: 10n, C: 10n })" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#fff3e0;strokeColor=#ff9800;fontStyle=1;fontSize=12;fontColor=#e65100;" vertex="1" parent="1">
          <mxGeometry x="360" y="55" width="280" height="50" as="geometry" />
        </mxCell>

        <!-- Tokenize -->
        <mxCell id="302" value="tokenize(expressionStr)&lt;br&gt;Scan characters into token list:&lt;br&gt;OP (+, -, *, /, ^), LPAREN, RPAREN, VAR, NUMBER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#757575;fontSize=11;fontColor=#212121;" vertex="1" parent="1">
          <mxGeometry x="360" y="135" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- Lexer Error Decision -->
        <mxCell id="303" value="Lexer Error?&lt;br&gt;(Invalid char or empty)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontStyle=1;fontSize=12;fontColor=#f57f17;" vertex="1" parent="1">
          <mxGeometry x="400" y="225" width="200" height="75" as="geometry" />
        </mxCell>

        <!-- Error Card -->
        <mxCell id="304" value="Display Syntax Error Banner&lt;br&gt;Halt calculation &amp;amp; scroll to error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#f44336;fontSize=11;fontColor=#b71c1c;" vertex="1" parent="1">
          <mxGeometry x="700" y="235" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- Grammar Entry -->
        <mxCell id="305" value="parseExpression() &amp;rarr; parseAdditive()&lt;br&gt;Initialize evaluation steps log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11;fontColor=#01579b;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="335" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- Additive Level -->
        <mxCell id="306" value="parseAdditive() [Precedence: Low]&lt;br&gt;left = parseMultiplicative()&lt;br&gt;While token is '+' or '−':&lt;br&gt;consume op &amp;amp; evaluate (left + right / left - right)&lt;br&gt;Log step in evaluation trace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#4caf50;fontSize=11;fontColor=#1b5e20;" vertex="1" parent="1">
          <mxGeometry x="365" y="420" width="270" height="80" as="geometry" />
        </mxCell>

        <!-- Multiplicative Level -->
        <mxCell id="307" value="parseMultiplicative() [Precedence: Medium]&lt;br&gt;left = parseExponential()&lt;br&gt;While token is '*' or '÷':&lt;br&gt;• If '*', res = left * right&lt;br&gt;• If '÷', check divisor != 0n (Trap Division by Zero)&lt;br&gt;res = left / right (integer division)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#673ab7;fontSize=11;fontColor=#311b92;" vertex="1" parent="1">
          <mxGeometry x="365" y="535" width="270" height="90" as="geometry" />
        </mxCell>

        <!-- Exponential Level -->
        <mxCell id="308" value="parseExponential() [Precedence: High]&lt;br&gt;left = parseUnary()&lt;br&gt;If token is '^':&lt;br&gt;right = parseExponential() [Right-Associative]&lt;br&gt;• Trap negative exponents (not in integer math)&lt;br&gt;• Trap exponent &amp;gt; 1000&lt;br&gt;res = left ** right" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#e91e63;fontSize=11;fontColor=#880e4f;" vertex="1" parent="1">
          <mxGeometry x="365" y="660" width="270" height="95" as="geometry" />
        </mxCell>

        <!-- Unary Level -->
        <mxCell id="309" value="parseUnary() [Prefix Precedence]&lt;br&gt;• If token is '−': consume &amp;amp; return -(parseUnary())&lt;br&gt;• If token is '+': consume &amp;amp; return parseUnary()&lt;br&gt;• Otherwise: return parsePrimary()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ffa000;fontSize=11;fontColor=#ff6f00;" vertex="1" parent="1">
          <mxGeometry x="365" y="790" width="270" height="70" as="geometry" />
        </mxCell>

        <!-- Primary Level -->
        <mxCell id="310" value="parsePrimary() [Atoms &amp;amp; Grouping]&lt;br&gt;• LPAREN '(': parseExpression(), match ')'&lt;br&gt;• VAR: lookup letter in variableValues map&lt;br&gt;• NUMBER: return token.value BigInt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#00acc1;fontSize=11;fontColor=#006064;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="365" y="895" width="270" height="75" as="geometry" />
        </mxCell>

        <!-- Unmatched Paren Handler -->
        <mxCell id="311" value="Trap Runtime Diagnostics&lt;br&gt;• Division by zero&lt;br&gt;• Mismatched parentheses&lt;br&gt;• Undefined variable name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#f44336;fontSize=11;fontColor=#b71c1c;" vertex="1" parent="1">
          <mxGeometry x="700" y="895" width="200" height="75" as="geometry" />
        </mxCell>

        <!-- Check Tokens Consumed -->
        <mxCell id="312" value="All Tokens Consumed?&lt;br&gt;(index == tokens.length)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontStyle=1;fontSize=12;fontColor=#f57f17;" vertex="1" parent="1">
          <mxGeometry x="400" y="1005" width="200" height="75" as="geometry" />
        </mxCell>

        <!-- Result Formatting & Proof Assembly -->
        <mxCell id="313" value="formatResultInBase(result, targetBase)&lt;br&gt;&amp;amp; createExpressionSolution()&lt;br&gt;• Step 1: Input Variable to Decimal Map Table&lt;br&gt;• Step 2: Substituted Decimal Expression&lt;br&gt;• Step 3: Step-by-Step PEMDAS Reduction Log&lt;br&gt;• Step 4: Division Proof of Final Result to Target Base" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#4caf50;fontSize=11;fontColor=#1b5e20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="1115" width="300" height="90" as="geometry" />
        </mxCell>

        <!-- Render Card -->
        <mxCell id="314" value="Render Arithmetic Result Card&lt;br&gt;• Calculated value badge in target base&lt;br&gt;• Variable chips summary&lt;br&gt;• Collapsible PEMDAS Proof breakdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11;fontColor=#01579b;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="365" y="1240" width="270" height="65" as="geometry" />
        </mxCell>

        <!-- Complete Node -->
        <mxCell id="315" value="Evaluation Complete" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#9e9e9e;fontStyle=1;fontSize=12;fontColor=#424242;" vertex="1" parent="1">
          <mxGeometry x="410" y="1340" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- Connectors -->
        <mxCell id="p1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ff9800;strokeWidth=2;" edge="1" parent="1" source="301" target="302">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#757575;strokeWidth=2;" edge="1" parent="1" source="302" target="303">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p3" value="Yes (Error)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f44336;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="303" target="304">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p4" value="No (Valid)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0288d1;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="303" target="305">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4caf50;strokeWidth=2;" edge="1" parent="1" source="305" target="306">
          <mxGeometry relative="1" as="geometry" />

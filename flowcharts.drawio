        <mxCell id="c4" value="No (Has text)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4caf50;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="203" target="205">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="c5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0288d1;strokeWidth=2;" edge="1" parent="1" source="205" target="206">

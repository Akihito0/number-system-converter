  <!-- ======================================================== -->
  <!-- DIAGRAM 2: Input Validation & Base Conversion Pipeline    -->
  <!-- ======================================================== -->
  <diagram id="diagram-conversion" name="2. Input Validation &amp; Base Conversion">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="t2" value="Single Register: Real-Time Radix Validation &amp; Bidirectional Conversion Pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1b5e20;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- Start Node -->
        <mxCell id="201" value="Event Triggered&lt;br&gt;(User input in Box or base button click)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#e8f5e9;strokeColor=#4caf50;fontStyle=1;fontSize=12;fontColor=#1b5e20;" vertex="1" parent="1">
          <mxGeometry x="380" y="55" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- Read Values -->
        <mxCell id="202" value="Read State Parameters&lt;br&gt;• rawString = numberInput.value&lt;br&gt;• inBase = data-selected-base (10, 2, 8, 16)&lt;br&gt;• outBase = data-selected-base (10, 2, 8, 16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#757575;fontSize=11;fontColor=#212121;" vertex="1" parent="1">
          <mxGeometry x="380" y="135" width="240" height="65" as="geometry" />
        </mxCell>

        <!-- Decision: Empty String -->
        <mxCell id="203" value="Is rawString&lt;br&gt;Empty?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontStyle=1;fontSize=12;fontColor=#f57f17;" vertex="1" parent="1">
          <mxGeometry x="410" y="235" width="180" height="75" as="geometry" />
        </mxCell>

        <!-- Empty Reset Action -->
        <mxCell id="204" value="Reset Box State&lt;br&gt;• validationMessage = &quot;&quot;&lt;br&gt;• outputValue = &quot;—&quot;&lt;br&gt;• solution = default prompt&lt;br&gt;• sync variable preview badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#9e9e9e;fontSize=11;fontColor=#424242;" vertex="1" parent="1">
          <mxGeometry x="690" y="240" width="210" height="65" as="geometry" />
        </mxCell>

        <!-- Validation Loop -->
        <mxCell id="205" value="validateInput(rawString, inBase)&lt;br&gt;For each char in upperString:&lt;br&gt;digit = getDigitValue(char)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11;fontColor=#01579b;" vertex="1" parent="1">
          <mxGeometry x="380" y="345" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Decision: Valid Characters -->
        <mxCell id="206" value="All digits within&lt;br&gt;0 &amp;lt;= digit &amp;lt; inBase?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontStyle=1;fontSize=12;fontColor=#f57f17;" vertex="1" parent="1">
          <mxGeometry x="400" y="440" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Invalid Handler -->
        <mxCell id="207" value="Display Validation Error&lt;br&gt;• &quot;Invalid input for Base N.&quot;&lt;br&gt;• outputValue = &quot;—&quot;&lt;br&gt;• Set red invalid styling&lt;br&gt;• Return false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#f44336;fontSize=11;fontColor=#b71c1c;" vertex="1" parent="1">
          <mxGeometry x="690" y="447" width="210" height="65" as="geometry" />
        </mxCell>

        <!-- Step 1: Horner's to Decimal -->
        <mxCell id="208" value="Step 1: convertToDecimal(value, inBase)&lt;br&gt;Horner's Method (BigInt):&lt;br&gt;decimalValue = decimalValue * inBase + digit&lt;br&gt;Generate Positional Expansion Proof" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#4caf50;fontSize=11;fontColor=#1b5e20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="365" y="555" width="270" height="70" as="geometry" />
        </mxCell>

        <!-- Step 2: Check Out Base -->
        <mxCell id="209" value="Is Target Base == 10?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontStyle=1;fontSize=12;fontColor=#f57f17;" vertex="1" parent="1">
          <mxGeometry x="410" y="660" width="180" height="75" as="geometry" />
        </mxCell>

        <!-- Base 10 Direct Output -->
        <mxCell id="210" value="Target is Decimal (Base 10)&lt;br&gt;convertedString = decimalValue.toString(10)&lt;br&gt;Proof: &quot;Value is already in Base 10.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#ab47bc;fontSize=11;fontColor=#4a148c;" vertex="1" parent="1">
          <mxGeometry x="110" y="670" width="230" height="55" as="geometry" />
        </mxCell>

        <!-- Base 2, 8, 16 Repeated Division -->
        <mxCell id="211" value="Step 2: createDivisionSolution()&lt;br&gt;Repeated Division Algorithm (BigInt):&lt;br&gt;• quotient = currentValue / outBase&lt;br&gt;• remainder = currentValue % outBase&lt;br&gt;• Record step, update currentValue = quotient&lt;br&gt;Loop until quotient == 0n" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#673ab7;fontSize=11;fontColor=#311b92;" vertex="1" parent="1">
          <mxGeometry x="365" y="770" width="270" height="85" as="geometry" />
        </mxCell>

        <!-- Format Remainder & Assembly -->
        <mxCell id="212" value="Format &amp;amp; Assemble Proof&lt;br&gt;• Format hex remainders &amp;gt;= 10 to A-F&lt;br&gt;• Read remainders from bottom to top&lt;br&gt;• Combine Step 1 Expansion + Step 2 Division" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#673ab7;fontSize=11;fontColor=#311b92;" vertex="1" parent="1">
          <mxGeometry x="365" y="890" width="270" height="65" as="geometry" />
        </mxCell>

        <!-- Render to DOM -->
        <mxCell id="213" value="Update DOM Elements&lt;br&gt;• outputValue.textContent = convertedString&lt;br&gt;• solutionContainer.textContent = fullProofText&lt;br&gt;• updateVariablePreviews() (Toolbar sync)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11;fontColor=#01579b;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="375" y="990" width="250" height="65" as="geometry" />
        </mxCell>

        <!-- Exit Node -->
        <mxCell id="214" value="Register State Updated" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#9e9e9e;fontStyle=1;fontSize=12;fontColor=#424242;" vertex="1" parent="1">
          <mxGeometry x="410" y="1090" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- Connectors -->
        <mxCell id="c1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4caf50;strokeWidth=2;" edge="1" parent="1" source="201" target="202">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#757575;strokeWidth=2;" edge="1" parent="1" source="202" target="203">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="c3" value="Yes (Empty)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#fbc02d;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="203" target="204">
          <mxGeometry relative="1" as="geometry" />
